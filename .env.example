# Backend muhit o'zgaruvchilari namunasi. Haqiqiy qiymatlarni ".env" ga yoki serverning
# muhit o'zgaruvchilariga yozing (.env .gitignore'da - commit qilinmaydi).
# Eslatma: Spring Boot .env faylni o'zi o'qimaydi. Lokal ishlash uchun odatiy yo'l -
# src/main/resources/application-local.properties + "local" profil (README ga qarang).

# --- Majburiy (standart qiymati yo'q) ---
DB_PASSWORD=o'zgartiring
# Base64 ko'rinishidagi kalit (kamida 32 bayt). Bu - faqat NAMUNA, prod da o'zingiznikini yarating:
#   openssl rand -base64 64
JWT_SECRET=bRqOYsFytGaoL0dHqBWnZ49R+xdsGyg7dwu8FF67Mn1x17MMCjLbKRHrimHjKLpwu/XV6RTL9JVLNh5ixmwMWg==

# --- Ixtiyoriy (qavs ichida standart qiymat) ---
DB_URL=jdbc:postgresql://localhost:5432/maktab_db
DB_USERNAME=postgres
# Bazada birorta foydalanuvchi bo'lmasa, shu login/parol bilan admin yaratiladi
ADMIN_USERNAME=admin
ADMIN_PASSWORD=o'zgartiring
CORS_ALLOWED_ORIGINS=http://localhost:9000
APP_STORAGE_PATH=./storage

# Telegram bot (batafsil: docs/15-telegram-bot.md)
TELEGRAM_ENABLED=false
TELEGRAM_MOCK=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=
TELEGRAM_QUIET_START=22:00
TELEGRAM_QUIET_END=07:00
TELEGRAM_UPDATE_THREADS=8
TELEGRAM_UPDATE_MAX_THREADS=16
TELEGRAM_UPDATE_QUEUE=2000

# Kutubxona
LIBRARY_MAX_PDF_MB=50
LIBRARY_MAX_COVER_MB=2
LIBRARY_DAILY_LIMIT=20
