# Serverdagi demo sozlamalari. Nusxa oling:  cp .env.example .env  - va qiymatlarni to'ldiring.
# .env HECH QACHON gitga qo'shilmaydi (.gitignore). Bu faylda faqat bo'sh joylar.
# Tasodifiy qiymat yaratish:  openssl rand -base64 48

# --- Majburiy ---
# Domen (DuckDNS: maktab-demo.duckdns.org). Caddy shu nomga HTTPS sertifikat oladi.
DOMAIN=
# PostgreSQL paroli (openssl rand -base64 24)
DB_PASSWORD=
# JWT kaliti: Base64, kamida 32 bayt (openssl rand -base64 64)
JWT_SECRET=
# Birinchi ishga tushishda yaratiladigan administrator paroli (bo'sh baza uchun)
ADMIN_PASSWORD=
# Tashrifchilar IP manzilining xeshi uchun tuz (openssl rand -hex 32)
VISIT_HASH_SALT=

# --- Ixtiyoriy (bo'sh qolsa - qavsdagi qiymat) ---
# Administrator logini (admin)
ADMIN_USERNAME=
# Baza nomi va foydalanuvchisi (maktab_db / maktab)
DB_NAME=
DB_USERNAME=
# Davomat va baholarni avtomatik to'ldiruvchi demo simulyator (true)
DEMO_ENABLED=
# #/demo havolasi orqali login/parolsiz "Mehmon" kirishi (true)
GUEST_LOGIN_ENABLED=
# Backend konteyneri xotirasi (3g)
BACKEND_MEMORY=

# --- Telegram bot (ixtiyoriy; false) ---
# DIQQAT: bot bir vaqtda faqat BITTA joyda ishlaydi. Serverda yoqsangiz, kompyuteringizdagi
# nusxada TELEGRAM_ENABLED=false qiling (aks holda ikkalasi ham xabarlarni yo'qotadi).
TELEGRAM_BOT_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Mini App: https://<DOMAIN>/#/webapp
TELEGRAM_WEBAPP_URL=
